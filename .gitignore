# datasets & model artifacts — never commit
# NOTE: these MUST be root-anchored (leading /). Without it, these patterns
# match a directory with this name ANYWHERE in the tree — which silently
# ignored emotion_analyzer/emotion_analyzer/models/ (the actual source
# package containing architectures.py and train.py) for this project's
# entire history, since gitignored files don't show up in `git status`.
# This was caught by an external audit, not internally — see
# docs/decisions.md D-016.
/data/
/models/
*.keras
*.h5
*.pth

# python
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# notebooks
.ipynb_checkpoints/

# streamlit
.streamlit/secrets.toml

# os
.DS_Store
